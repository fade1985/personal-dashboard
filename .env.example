# OAuth Client ID (tipo "Aplicación web") de Google Cloud Console.
# Orígenes JavaScript autorizados: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Clave gratuita de RAWG (https://rawg.io/apidocs) para buscar juegos y fechas de lanzamiento.
# Sin prefijo VITE_: solo la usa el servidor de desarrollo, no llega al navegador.
RAWG_KEY=
